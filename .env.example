# ─────────────────────────────────────────────────────────────
# Website Analyzer — environment configuration
# Copy to `.env` and adjust for your machine:  cp .env.example .env
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# General
NODE_ENV=development

# API
API_PORT=4000
WEB_URL=http://localhost:3000
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Database (PostgreSQL — docker compose in infrastructure/)
# Host port is 5433 so the container does not clash with a locally installed
# PostgreSQL occupying 5432.
DATABASE_URL=postgres://analyzer:analyzer@localhost:5433/analyzer
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=analyzer
POSTGRES_DB=analyzer
POSTGRES_PORT=5433

# Cache / Queue (Redis — docker compose in infrastructure/)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Web (Next.js reads NEXT_PUBLIC_* vars from its own environment;
# defaults to http://localhost:4000 when unset)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication (JWT)
# Development-only values — always set real secrets outside local development.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Seed (local development only)
SEED_EMAIL=demo@analyzer.dev
SEED_PASSWORD=demo-password-123

# Request throttling (per IP, Redis-backed sliding window)
# General API budget (one shared counter per client across all routes).
THROTTLE_TTL=60000
THROTTLE_LIMIT=600
# Authentication endpoints (login/register/refresh share one counter).
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
# Analysis creation (triggers deterministic run + AI enrichment).
THROTTLE_ANALYSIS_TTL=300000
THROTTLE_ANALYSIS_LIMIT=20
# Behavior when Redis cannot serve the counter: open | closed.
# Authentication endpoints always fail closed regardless of this value.
RATE_LIMIT_REDIS_FAILURE=open
# Counter namespace, so environments can share one Redis instance.
RATE_LIMIT_KEY_PREFIX=rl:

# Security
# Extra browser origins allowed to call the API (comma-separated).
# Falls back to WEB_URL when unset; wildcards are never allowed.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Analysis job policy (retry/backoff for queued runs)
ANALYSIS_JOB_ATTEMPTS=3
ANALYSIS_JOB_BACKOFF_DELAY_MS=2000

# Worker
WORKER_QUEUE_NAME=analysis
WORKER_CONCURRENCY=1
AI_CONCURRENCY=1
# Runs stuck in `running` longer than this are recovered as stale.
WORKER_STALE_RUN_THRESHOLD_MS=600000
WORKER_STALE_CHECK_INTERVAL_MS=60000

# Analysis fetch limits (SSRF-safe defaults; validated at startup)
FETCH_CONNECTION_TIMEOUT_MS=10000
FETCH_TOTAL_TIMEOUT_MS=30000
FETCH_MAX_REDIRECTS=5
FETCH_MAX_RESPONSE_BYTES=5000000

# AI orchestration (worker-side enrichment)
# Provider selection is config-driven; API keys come from the environment
# only. Without AI_API_KEY, AI jobs fail fast (AI_CONFIG_INVALID) and the
# deterministic analysis is never affected.
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-… (never commit real keys)
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_FINDINGS=30
AI_MAX_RECOMMENDATIONS=8
AI_MAX_REPAIRS=1
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_DELAY_MS=2000