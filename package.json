{
  "name": "website-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "AI SaaS Website Analyzer — monorepo",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infrastructure/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml --env-file .env down",
    "db:logs": "docker compose -f infrastructure/docker-compose.yml --env-file .env logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
