{
  "name": "@analyzer/api",
  "version": "0.1.0",
  "private": true,
  "description": "Website Analyzer REST API (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@analyzer/analysis": "workspace:*",
    "@analyzer/config": "workspace:*",
    "@analyzer/contracts": "workspace:*",
    "@analyzer/report": "workspace:*",
    "@analyzer/shared": "workspace:*",
    "bullmq": "^5.40.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.10.0",
    "class-transformer": "^0.5.1",
    "prisma": "^6.10.0",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.11.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.30.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.35.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}